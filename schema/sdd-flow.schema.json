{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/sdd-flow.schema.json",
  "title": "SDD experience and realization flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenario", "stories", "experience", "subflows"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project", "domain", "title", "heading", "status", "defaultStory", "defaultPath", "selectedNode"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "project": { "$ref": "#/$defs/nonEmptyString" },
        "domain": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "heading": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "defaultStory": { "$ref": "#/$defs/id" },
        "defaultPath": { "enum": ["happy", "exception", "all"] },
        "selectedNode": { "$ref": "#/$defs/id" }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "state", "nodes"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "$ref": "#/$defs/nonEmptyString" },
          "state": { "$ref": "#/$defs/nonEmptyString" },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/experienceNode" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "subflows": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title", "summary", "entry", "exits", "tracks", "groups", "nodes", "edges"],
        "properties": {
          "kind": { "enum": ["interaction", "orchestration"] },
          "title": { "$ref": "#/$defs/nonEmptyString" },
          "summary": { "$ref": "#/$defs/nonEmptyString" },
          "entry": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "exits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["happy", "exception"],
            "properties": {
              "happy": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/id" }
              },
              "exception": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/id" }
              }
            }
          },
          "tracks": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/track" }
          },
          "groups": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/id" },
            "additionalProperties": { "$ref": "#/$defs/group" }
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/realizationNode" }
          },
          "edges": {
            "type": "array",
            "items": { "$ref": "#/$defs/edge" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "enum": ["happy", "exception", "both"]
    },
    "nodeType": {
      "enum": ["view", "action", "command", "integration", "decision", "event", "state"]
    },
    "experienceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "title", "technical", "detail"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["view", "action", "event", "state"] },
        "path": { "$ref": "#/$defs/path" },
        "expands": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "technical": { "$ref": "#/$defs/nonEmptyString" },
        "detail": { "$ref": "#/$defs/detail" }
      }
    },
    "realizationNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "track", "type", "path", "title", "technical", "detail"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "track": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/nodeType" },
        "path": { "$ref": "#/$defs/path" },
        "join": { "enum": ["all", "any"] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "technical": { "$ref": "#/$defs/nonEmptyString" },
        "detail": { "$ref": "#/$defs/detail" }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "behavior", "assumption", "links"],
      "properties": {
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["given", "when", "then"],
          "properties": {
            "given": { "$ref": "#/$defs/nonEmptyString" },
            "when": { "$ref": "#/$defs/nonEmptyString" },
            "then": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "assumption": { "$ref": "#/$defs/nonEmptyString" },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "code"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "code": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "mode", "members"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "mode": { "enum": ["unordered", "parallel"] },
        "members": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "path"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["sequence", "triggers", "produces", "reads", "writes", "requests", "responds", "transitions", "returns", "enables"]
        },
        "path": { "$ref": "#/$defs/path" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "loop": { "type": "boolean" }
      }
    }
  }
}
